{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::accelerator-shared-artifacts",
        "arn:aws:s3:::accelerator-shared-artifacts/*"
      ]
    }
  ]
}
