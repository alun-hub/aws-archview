{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* Tests read fixtures off disk and check env vars; app code must not, which
       is why this lives here and not in tsconfig.app.json. */
    "types": ["vite/client", "node", "vitest/globals"],
    "noEmit": true
  },
  "include": ["src/**/__tests__/**/*.ts", "src/**/__tests__/**/*.tsx"],
  "exclude": []
}
